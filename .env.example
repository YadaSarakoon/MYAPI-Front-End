# Copy to .env.local and populate Firebase values from your Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Use the Development API URL. Set another environment explicitly when approved.
VITE_API_BASE_URL=https://dev-open-api.myexpress.ai
